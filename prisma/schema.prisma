// NumberSmith database schema
//
// NOTE ON STRING "ENUMS": fields that would be enums (role, status,
// difficulty tier, competition format, etc.) are modeled as `String` with
// the allowed values documented in a comment above each field, plus a
// matching TypeScript union type in src/lib/types.ts and Zod validation at
// every write boundary. Upgrading these to real Postgres `enum` blocks is a
// mechanical, low-risk change if ever wanted — no relational shape changes
// required. Left as String for now since nothing requires the stricter
// guarantee yet.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Users & profiles
// ---------------------------------------------------------------------------

/// role: STUDENT | PARENT | TEACHER | ADMIN
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  /// Null for accounts created via Google sign-in that have never set a
  /// password — login must check this before attempting bcrypt.compare.
  passwordHash String?
  /// Google's stable per-account subject id ("sub" claim), not their email —
  /// emails can change on the Google side, this can't.
  googleId     String? @unique
  name         String
  role         String  @default("STUDENT")

  /// Recorded at signup so consent to the Terms/Privacy Policy is evidenced by
  /// a server-side timestamp and version, not just a checkbox that leaves no
  /// trace. Nullable because accounts created before this field existed have
  /// neither. See LEGAL.lastUpdated in src/lib/legal.ts for the version string.
  termsAcceptedAt      DateTime?
  termsAcceptedVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          Profile?
  subscription     Subscription?
  stats            UserStats?
  parentLinks      ParentLink[]           @relation("ParentToChild")
  childLinks       ParentLink[]           @relation("ChildToParent")
  taughtClasses    ClassRoom[]            @relation("TeacherClasses")
  classMemberships ClassMembership[]
  scratchWork      ScratchWork[]
  uploadedPapers   UploadedPaper[]
  paperScans       PaperScan[]
  paperAttempts    UploadedPaperAttempt[]

  userCompetitions       UserCompetition[]
  attempts               Attempt[]
  mistakes               Mistake[]
  bookmarks              Bookmark[]
  competitionAttempts    CompetitionAttempt[]
  ratings                Rating[]
  ratingHistory          RatingHistory[]
  topicMastery           TopicMastery[]
  userAchievements       UserAchievement[]
  studyPlans             StudyPlan[]
  placementTests         PlacementTest[]
  dailyChallengeAttempts DailyChallengeAttempt[]
  lessonProgress         LessonProgress[]
  passwordResetTokens    PasswordResetToken[]
  videoLessonProgress    VideoLessonProgress[]
  aiChatMessages         AiChatMessage[]

  @@index([role])
}

/// Only the SHA-256 hash of the 6-digit code is ever persisted. Not globally
/// unique — two different users can coincidentally be issued the same code,
/// which is fine, since verification is always scoped to one userId. A small
/// numeric space is brute-forceable without extra limits, so this also
/// tracks `attempts`: the code is invalidated after 5 wrong guesses rather
/// than relying on hash strength or the short expiry alone.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// ageRange: e.g. "5-7" | "8-10" | "11-13" | "14-15" | "16-18"
/// priorExperience: NONE | SOME | EXPERIENCED | ADVANCED
/// approxLevel (self-reported): BEGINNER | INTERMEDIATE | ADVANCED | NOT_SURE
model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade                 Int // 0 = Kindergarten, 1-12
  ageRange              String?
  priorExperience       String    @default("NONE")
  priorCompetitions     String    @default("[]") // JSON array of competition slugs the student has done before
  approxLevel           String    @default("NOT_SURE")
  dailyPracticeMinutes  Int       @default(20)
  targetScore           String?
  onboardingStep        String    @default("PROFILE") // PROFILE | PLACEMENT | RESULTS | COMPETITIONS | PLAN | DONE
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation("ParentToChild", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     User     @relation("ChildToParent", fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
}

model ClassRoom {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique
  teacherId String
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members     ClassMembership[]
  assignments TeacherAssignment[]
}

model ClassMembership {
  id        String    @id @default(cuid())
  classId   String
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())

  @@unique([classId, userId])
}

/// taskType: PROBLEM_SET | SIMULATION | QUIZ
model TeacherAssignment {
  id         String    @id @default(cuid())
  classId    String
  classRoom  ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  taskType   String
  problemIds String // JSON array of Problem ids
  dueAt      DateTime?
  createdAt  DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Competitions
// ---------------------------------------------------------------------------

/// category: ELEMENTARY_MIDDLE | HIGH_SCHOOL | OLYMPIAD
/// format: MULTIPLE_CHOICE | SHORT_ANSWER | INTEGER | PROOF
/// individualOrTeam: INDIVIDUAL | TEAM | BOTH
model Competition {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortName        String
  category         String
  format           String
  individualOrTeam String
  gradeMin         Int
  gradeMax         Int
  difficultyMin    Int // 1-10 scale
  difficultyMax    Int
  numQuestions     Int?
  timeLimitMinutes Int?
  region           String   @default("USA")
  organization     String?
  description      String
  roadmap          String? // markdown roadmap text
  order            Int      @default(0)
  isPlaceholder    Boolean  @default(false)
  createdAt        DateTime @default(now())

  topics              CompetitionTopic[]
  problems            Problem[]
  userCompetitions    UserCompetition[]
  competitionAttempts CompetitionAttempt[]
  studyPlans          StudyPlan[]
  dailyChallenges     DailyChallenge[]
}

model CompetitionTopic {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  weight        Int         @default(1) // relative emphasis, 1-5

  @@unique([competitionId, topicId])
}

/// isPrimary marks the student's #1 priority competition
/// A competition the student is training for, and — once they fill it in — when
/// they are sitting it. The rows with a targetDate are the student's schedule,
/// and generateStudyPlan builds the training arc backwards from those dates.
model UserCompetition {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  isPrimary     Boolean     @default(false)
  /// Contest date. Nullable: a student can follow a competition without having
  /// a date yet, and those still shape practice, they just do not anchor the
  /// calendar. Stored as that day's UTC midnight, the same date-only convention
  /// as DailyChallenge.date.
  targetDate    DateTime?
  addedAt       DateTime    @default(now())

  @@unique([userId, competitionId])
}

// ---------------------------------------------------------------------------
// Topics
// ---------------------------------------------------------------------------

/// domain-level topics have parentId = null (Arithmetic, Algebra, Geometry,
/// Number Theory, Combinatorics, Probability, Logic, Advanced/Olympiad).
/// subtopics reference their domain via parentId.
model Topic {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Topic[] @relation("TopicHierarchy")
  order    Int     @default(0)

  problems          Problem[]
  competitionTopics CompetitionTopic[]
  topicMastery      TopicMastery[]
  lessons           Lesson[]
  videoLessons      VideoLesson[]
  studyPlanDays     StudyPlanDay[]
}

// ---------------------------------------------------------------------------
// Problems
// ---------------------------------------------------------------------------

/// format: MULTIPLE_CHOICE | SHORT_ANSWER | INTEGER
/// difficulty: 1-10 (1-2 Beginner, 3-4 Intermediate-, 5-6 Intermediate+,
///   7-8 Advanced, 9-10 Expert)
model Problem {
  id                   String       @id @default(cuid())
  slug                 String       @unique
  question             String
  /// Optional inline SVG figure shown above the question. Authored by us in the
  /// seed data, never user-supplied — see ProblemFigure for the render-side
  /// constraints this is trusted under.
  diagram              String?
  format               String
  choices              String? // JSON string array, only for MULTIPLE_CHOICE
  answer               String // canonical answer, e.g. "C" or "13" or "042"
  solution             String
  /// Additional approaches to the same problem, as a JSON array of
  /// {label, body}. Empty for most problems.
  ///
  /// Competition maths is largely about seeing that a problem yields to
  /// counting *or* symmetry *or* a complementary count. One solution teaches
  /// the answer; a second teaches the choice. Kept as JSON on the row rather
  /// than a table because they are read only alongside their problem, never
  /// queried across problems.
  altSolutions         String       @default("[]")
  hints                String // JSON string array
  difficulty           Int
  topicId              String
  topic                Topic        @relation(fields: [topicId], references: [id])
  competitionId        String?
  competition          Competition? @relation(fields: [competitionId], references: [id])
  gradeMin             Int
  gradeMax             Int
  estimatedTimeSeconds Int          @default(120)
  tags                 String       @default("[]") // JSON string array
  source               String       @default("NumberSmith Original")
  license              String       @default("NumberSmith Original")
  year                 Int?
  author               String       @default("Aarit Chakraborty")
  isPlacement          Boolean      @default(false)
  isPublished          Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  attempts                Attempt[]
  mistakes                Mistake[]
  bookmarks               Bookmark[]
  placementAttempts       PlacementAttempt[]
  competitionAttemptItems CompetitionAttemptItem[]
  dailyChallenges         DailyChallenge[]
  lessonPractice          LessonProblem[]
  scratchWork             ScratchWork[]

  @@index([topicId])
  @@index([difficulty])
  @@index([competitionId])
  @@index([format])
  @@index([isPlacement])
}

// ---------------------------------------------------------------------------
// Lessons
// ---------------------------------------------------------------------------

model Lesson {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id])
  concept        String
  explanation    String
  workedExample  String
  strategy       String
  commonMistakes String
  difficulty     Int      @default(1)
  order          Int      @default(0)
  isPremium      Boolean  @default(false)
  createdAt      DateTime @default(now())

  practiceProblems LessonProblem[]
  progress         LessonProgress[]
  studyPlanDays    StudyPlanDay[]
}

/// role: PRACTICE | CHALLENGE
model LessonProblem {
  id        String  @id @default(cuid())
  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  role      String  @default("PRACTICE")
  order     Int     @default(0)

  @@unique([lessonId, problemId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  masteryPct  Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

// ---------------------------------------------------------------------------
// Video lessons (Pro-only). "Video" here is a narrated-free, animated visual
// walkthrough rendered client-side from a scene script — not a media file —
// so lessons are diffable, searchable, and never need re-encoding. `scenes`
// is a JSON-encoded array of SceneSeed objects (see
// src/lib/video-lessons/types.ts for the shape the player renders).
// ---------------------------------------------------------------------------

model VideoLesson {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  topicId         String
  topic           Topic    @relation(fields: [topicId], references: [id])
  difficulty      Int      @default(1)
  order           Int      @default(0)
  summary         String
  durationMinutes Int      @default(6)
  scenes          String
  createdAt       DateTime @default(now())

  progress VideoLessonProgress[]
}

model VideoLessonProgress {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoLessonId String
  videoLesson   VideoLesson @relation(fields: [videoLessonId], references: [id], onDelete: Cascade)
  completed     Boolean     @default(false)
  completedAt   DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([userId, videoLessonId])
}

// ---------------------------------------------------------------------------
// AI Math Assistant (Pro-only). One growing thread per user rather than
// multiple named sessions — simplest model that still supports follow-up
// questions, since the whole history threads by createdAt. "Clear" deletes
// the user's rows outright rather than soft-archiving them.
// ---------------------------------------------------------------------------

model AiChatMessage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// role: user | assistant
  role           String
  content        String
  /// Base64 of a file the student attached (user messages only) — a screenshot
  /// or a PDF worksheet. Stored in the row rather than in blob storage: the app
  /// has no object store, the client downscales images before upload and PDFs
  /// are capped at a few MB, and the file is meaningless outside the message it
  /// belongs to — so cascade-deleting with the thread is exactly the lifecycle
  /// we want.
  ///
  /// Mapped to a column still named "imageData" because it predates PDF
  /// support, and renaming the column would mean another migration against the
  /// production database for zero behavioural gain. The field name is what the
  /// code reads, so only this mapping remembers the older, narrower name.
  attachmentData String?  @map("imageData")
  /// MIME type of attachmentData, e.g. "image/jpeg" or "application/pdf".
  /// Needed both to render it back and to tell the model what it's looking at —
  /// images and PDFs go to the API as different block types.
  attachmentType String?  @map("imageType")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Placement testing
// ---------------------------------------------------------------------------

/// status: IN_PROGRESS | COMPLETED
/// level: BEGINNER | DEVELOPING | INTERMEDIATE | ADVANCED | EXPERT
model PlacementTest {
  id                       String    @id @default(cuid())
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   String    @default("IN_PROGRESS")
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  resultRating             Int?
  resultLevel              String?
  skillBreakdown           String? // JSON: { [topicSlug]: percent }
  strengthTopicId          String?
  opportunityTopicId       String?
  recommendedCompetitionId String?
  currentDifficulty        Int       @default(4)
  consecutiveCorrect       Int       @default(0)
  consecutiveIncorrect     Int       @default(0)

  attempts PlacementAttempt[]
}

model PlacementAttempt {
  id               String        @id @default(cuid())
  placementTestId  String
  placementTest    PlacementTest @relation(fields: [placementTestId], references: [id], onDelete: Cascade)
  problemId        String
  problem          Problem       @relation(fields: [problemId], references: [id])
  order            Int
  difficultyAtTime Int
  answerGiven      String?
  correct          Boolean
  timeSeconds      Int
  createdAt        DateTime      @default(now())

  @@unique([placementTestId, order])
}

// ---------------------------------------------------------------------------
// Practice attempts, mistakes, bookmarks
// ---------------------------------------------------------------------------

/// mode: PRACTICE | DAILY_CHALLENGE | SIMULATION | PLACEMENT | LESSON | MISTAKE_REVIEW
/// MISTAKE_REVIEW attempts are recorded and scored like any other, but award no
/// XP and no rating — the problems are ones the user has already seen the
/// solution to, so paying out would make the review queue the cheapest points
/// in the app. Enforced in submitPracticeAnswerAction.
model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  mode        String   @default("PRACTICE")
  answerGiven String?
  correct     Boolean
  timeSeconds Int
  hintsUsed   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([problemId])
}

/// reason: INCORRECT | SKIPPED | SLOW | MULTI_HINT
model Mistake {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String
  problem        Problem   @relation(fields: [problemId], references: [id])
  reason         String
  reviewCount    Int       @default(0)
  resolved       Boolean   @default(false)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@unique([userId, problemId])
  @@index([userId, resolved, nextReviewAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
}

// ---------------------------------------------------------------------------
// Competition simulations
// ---------------------------------------------------------------------------

/// mode: OFFICIAL | CUSTOM
/// status: IN_PROGRESS | SUBMITTED
model CompetitionAttempt {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id])
  mode             String      @default("OFFICIAL")
  status           String      @default("IN_PROGRESS")
  startedAt        DateTime    @default(now())
  submittedAt      DateTime?
  timeLimitSeconds Int
  totalQuestions   Int
  correctCount     Int         @default(0)
  score            Int         @default(0)
  config           String? // JSON: custom config (topics, difficulty, count)

  items CompetitionAttemptItem[]

  @@index([userId, competitionId])
}

model CompetitionAttemptItem {
  id                   String             @id @default(cuid())
  competitionAttemptId String
  competitionAttempt   CompetitionAttempt @relation(fields: [competitionAttemptId], references: [id], onDelete: Cascade)
  problemId            String
  problem              Problem            @relation(fields: [problemId], references: [id])
  order                Int
  answerGiven          String?
  correct              Boolean?
  flagged              Boolean            @default(false)
  timeSeconds          Int                @default(0)

  @@unique([competitionAttemptId, order])
}

// ---------------------------------------------------------------------------
// Ratings, mastery, XP, streaks
// ---------------------------------------------------------------------------

/// category: OVERALL | AMC | MATHCOUNTS | OLYMPIAD | <topic-slug>
model Rating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  value     Int      @default(1000)
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
}

model RatingHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String
  value      Int
  delta      Int      @default(0)
  reason     String // e.g. "Placement Test", "AMC 8 Simulation", "Daily Practice"
  recordedAt DateTime @default(now())

  @@index([userId, category, recordedAt])
}

model TopicMastery {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId           String
  topic             Topic     @relation(fields: [topicId], references: [id])
  masteryPercent    Int       @default(0)
  problemsAttempted Int       @default(0)
  problemsCorrect   Int       @default(0)
  lastPracticedAt   DateTime?
  updatedAt         DateTime  @updatedAt

  @@unique([userId, topicId])
}

model UserStats {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp         Int       @default(0)
  level           Int       @default(1)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveDate  DateTime?
  problemsSolved  Int       @default(0)
  problemsCorrect Int       @default(0)
  updatedAt       DateTime  @updatedAt
}

/// category: MILESTONE | ACCURACY | SPEED | MASTERY | STREAK | COMPETITION
model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  category    String
  criteria    String // JSON: { type, threshold, ... }
  xpReward    Int    @default(50)
  order       Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ---------------------------------------------------------------------------
// Daily challenge
// ---------------------------------------------------------------------------

/// track: ELEMENTARY | MIDDLE_SCHOOL | AMC8 | AMC10 | AMC12 | AIME | OLYMPIAD
model DailyChallenge {
  id            String       @id @default(cuid())
  date          DateTime // normalized to UTC midnight
  track         String
  problemId     String
  problem       Problem      @relation(fields: [problemId], references: [id])
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id])

  attempts DailyChallengeAttempt[]

  @@unique([date, track])
}

model DailyChallengeAttempt {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyChallengeId String
  dailyChallenge   DailyChallenge @relation(fields: [dailyChallengeId], references: [id])
  correct          Boolean
  timeSeconds      Int
  xpAwarded        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([userId, dailyChallengeId])
}

// ---------------------------------------------------------------------------
// Study plans
// ---------------------------------------------------------------------------

model StudyPlan {
  id                   String       @id @default(cuid())
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryCompetitionId String?
  primaryCompetition   Competition? @relation(fields: [primaryCompetitionId], references: [id])
  competitionDate      DateTime?
  currentRating        Int
  targetRating         Int?
  minutesPerDay        Int          @default(30)
  generatedAt          DateTime     @default(now())
  active               Boolean      @default(true)

  days StudyPlanDay[]
}

/// taskType: LESSON | PRACTICE | TIMED_SET | SIMULATION | REVIEW
model StudyPlanDay {
  id           String    @id @default(cuid())
  studyPlanId  String
  studyPlan    StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  weekNumber   Int
  dayOfWeek    Int // 0=Sunday .. 6=Saturday
  taskType     String
  topicId      String?
  topic        Topic?    @relation(fields: [topicId], references: [id])
  lessonId     String?
  lesson       Lesson?   @relation(fields: [lessonId], references: [id])
  problemCount Int       @default(5)
  label        String
  completed    Boolean   @default(false)
  completedAt  DateTime?

  @@index([studyPlanId, weekNumber, dayOfWeek])
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

/// status: FREE | PRO | TRIAL | CANCELED
/// plan: MONTHLY | YEARLY | null
/// paymentProvider: STRIPE | null (no live provider wired up in the MVP)
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 String    @default("FREE")
  plan                   String?
  startDate              DateTime?
  renewalDate            DateTime?
  trialEndsAt            DateTime?
  paymentProvider        String?
  externalCustomerId     String? // Stripe customer id (cus_...)
  /// Stripe subscription id (sub_...). Needed to correlate incoming
  /// customer.subscription.* webhook events back to this row.
  externalSubscriptionId String?   @unique
  canceledAt             DateTime?
  updatedAt              DateTime  @updatedAt

  @@index([externalCustomerId])
}

/// Stripe retries webhook deliveries, so every event id is recorded here the
/// first time it is handled and skipped on redelivery. Without this, a retried
/// invoice event could extend a subscription twice.
model WebhookEvent {
  id          String   @id // Stripe event id (evt_...)
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Scratch work and student-supplied papers
// ---------------------------------------------------------------------------

/// A student's working for one problem, as a PNG data URL.
///
/// Competition maths is done with scribbles, and the product had nowhere to
/// put them: a student worked on paper beside the screen, so the reasoning
/// behind a wrong answer was never captured. Keeping it means a mistake can be
/// reviewed with the working that produced it — and Smith AI can read it,
/// since it already accepts images.
///
/// Stored as a raster data URL rather than vector strokes because every
/// consumer wants an image, and one blob avoids a row per stroke. Callers cap
/// the size before writing; see saveScratchAction.
model ScratchWork {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  data      String
  updatedAt DateTime @updatedAt

  /// One canvas per student per problem — revisiting a problem continues the
  /// same working rather than starting a second sheet.
  @@unique([userId, problemId])
}

/// A real past paper a student uploaded, with the answer key they typed in.
///
/// The bank can never contain the official papers, which is exactly what a
/// student sitting a contest most wants to practise on. Rather than trying to
/// parse a PDF into problems — unreliable, and a misread question is worse
/// than none — the student supplies the answer key once, then sits the paper
/// against a clock with the PDF on screen and gets scored. No extraction, no
/// guessing at the mathematics.
/// RETIRED: the Past Papers feature was removed. No code reads or writes these
/// three models (UploadedPaper, UploadedPaperAttempt, PaperScan) any more.
///
/// They are kept in the schema on purpose. Deleting a model here makes the next
/// `prisma migrate` generate a DROP TABLE, which would destroy uploaded PDFs
/// and sittings that students still own. Keeping them costs nothing — no code
/// paths, no queries — and keeps that data recoverable. Drop them deliberately,
/// with a migration written for the purpose, if and when the data is genuinely
/// not wanted.
model UploadedPaper {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  /// Base64 of the PDF, no data: prefix — the same convention AiChatMessage
  /// uses for attachments.
  fileData         String
  questionCount    Int
  timeLimitMinutes Int
  /// JSON array of the marking key, one entry per question.
  answerKey        String
  /// Where that key came from: PRINTED (read off the paper's own key), SOLVED
  /// (NumberSmith worked the questions out, because the PDF had no key), or
  /// MANUAL (the student typed it).
  ///
  /// Stored rather than inferred because the three carry different authority
  /// and the results screen has to say which one produced a mark. A student
  /// told they got a question wrong is owed the difference between "the paper
  /// says so" and "we worked it out and could be wrong". Defaults to MANUAL so
  /// papers uploaded before this existed keep describing themselves honestly.
  answerSource     String   @default("MANUAL")
  /// JSON array of the questions read out of the PDF, one entry per question:
  /// `{ text, choices[], confidence, note }`. Empty array when the paper was
  /// entered by hand rather than scanned — that path still works, and a paper
  /// with no questions here is sat with the PDF on screen instead of quizzed
  /// one question at a time.
  ///
  /// Stored rather than re-derived because extraction is non-deterministic and
  /// costs an API call: a second sitting of the same paper must ask the same
  /// questions as the first, or two attempts are not comparable.
  questions        String   @default("[]")
  createdAt        DateTime @default(now())

  attempts UploadedPaperAttempt[]

  @@index([userId])
}

/// One row per attempt to scan a PDF, for the daily cap.
///
/// A scan is the most expensive thing a student can do — an entire PDF through
/// Opus — and it stores nothing on its own: a student can scan, dislike the
/// result, and scan again forever. Counting saved papers instead would miss
/// exactly that case, so the attempt itself is what gets recorded.
///
/// Written *before* the API call, not after, because a scan that fails still
/// spent the tokens. A cap that only counted successes would let a malformed
/// PDF be retried without limit.
///
/// Deliberately holds no file data. It exists to be counted and then to age
/// out; keeping a copy of every PDF anyone ever pointed at the scanner would
/// be a second, unasked-for store of student files.
model PaperScan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UploadedPaperAttempt {
  id           String        @id @default(cuid())
  paperId      String
  paper        UploadedPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// JSON array of what the student answered, one entry per question.
  answers      String        @default("[]")
  /// JSON array of worked explanations, one entry per question, `""` where
  /// there is nothing to explain (right answer, or left blank).
  ///
  /// Stored rather than produced on demand because it is the expensive half of
  /// marking and it must not change: a student who reloads their results, or
  /// comes back to them a week later, has to see the same explanation they
  /// read the first time. Re-deriving would also re-bill a paper every time it
  /// was opened.
  explanations String        @default("[]")
  correctCount Int           @default(0)
  status       String        @default("IN_PROGRESS")
  startedAt    DateTime      @default(now())
  submittedAt  DateTime?

  @@index([userId])
}
